<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan Vertical Pipe / Accessory / Fixture vs Linked Detail Item (v9)"
        Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="12">

        <TextBlock Text="1. Revit Link và Linked view" FontWeight="Bold"/>
        <Grid Margin="0,4,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cb_link" Grid.Column="0" Margin="0,0,4,0"/>
            <ComboBox x:Name="cb_view" Grid.Column="1" Margin="4,0,0,0"/>
        </Grid>
        <TextBlock x:Name="tb_view_info" Foreground="Gray" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBlock Text="2. Detail item mẫu" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
            <Button x:Name="btn_pick" Content="Chọn detail item mẫu trên màn hình" Width="230"/>
            <TextBlock Text="hoặc ID (trong link):" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox x:Name="tb_detail_id" Width="110" Height="24" VerticalContentAlignment="Center"/>
            <Button x:Name="btn_by_id" Content="Lấy theo ID" Width="90" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="tb_sample_info" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8"/>

        <TextBlock Text="3. Chọn các mẫu (vùng) cần quét - bấm vào từng dòng để chọn / bỏ chọn, chọn được nhiều mẫu"
                   FontWeight="Bold" TextWrapping="Wrap"/>
        <Grid Margin="0,4,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="lb_patterns" Grid.Column="0" Height="200" Margin="0,0,8,0"
                     SelectionMode="Multiple" FontFamily="Consolas" FontSize="11"/>
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Background="White">
                <Canvas x:Name="cv_preview" Width="300" Height="200" ClipToBounds="True"/>
            </Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
            <Button x:Name="btn_sel_all" Content="Chọn tất cả" Width="90"/>
            <Button x:Name="btn_sel_none" Content="Bỏ chọn" Width="90" Margin="6,0,0,0"/>
            <Button x:Name="btn_draw_sample" Content="Vẽ thử các mẫu đang chọn lên view" Width="220" Margin="6,0,0,0"/>
            <TextBlock x:Name="tb_sel_info" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <TextBlock Text="4. Phạm vi detail item cần quét" FontWeight="Bold"/>
        <Grid Margin="0,4,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tên chứa:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="tb_contains" Grid.Column="1" Height="24" VerticalContentAlignment="Center"/>
            <Button x:Name="btn_count" Grid.Column="2" Content="Đếm" Width="80" Margin="6,0,0,0"/>
        </Grid>
        <CheckBox x:Name="chk_samefam" Content="Chỉ lấy detail item cùng Family với mẫu"
                  IsChecked="True" Margin="0,4,0,0"/>
        <TextBlock x:Name="tb_count" Margin="0,2,0,8" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <TextBlock Text="5. Đối tượng quét (trong model hiện tại)" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <CheckBox x:Name="chk_pipe" Content="Ống đứng" IsChecked="True"/>
            <CheckBox x:Name="chk_acc" Content="Pipe Accessories" IsChecked="True" Margin="16,0,0,0"/>
            <CheckBox x:Name="chk_fix" Content="Plumbing Fixtures" IsChecked="True" Margin="16,0,0,0"/>
            <CheckBox x:Name="chk_inview" Content="Chỉ đối tượng hiển thị trong active view"
                      IsChecked="True" Margin="16,0,0,0"/>
        </StackPanel>
        <CheckBox x:Name="chk_cutonly" Margin="0,4,0,0"
                  Content="Chỉ lấy đối tượng cắt qua cut plane của view (bỏ ống đứng chỉ nằm trong view depth)"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Accessory / Fixture kiểm tra theo:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cb_foot" Width="300" Margin="6,0,0,0" SelectedIndex="0">
                <ComboBoxItem Content="Hình chiếu thật (hình học 3D chiếu xuống)"/>
                <ComboBoxItem Content="Điểm đặt family (location point)"/>
                <ComboBoxItem Content="Bounding box (rộng nhất)"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Dung sai (mm):" VerticalAlignment="Center"/>
            <TextBox x:Name="tb_tol" Text="0" Width="60" Margin="6,0,0,0"/>
            <TextBlock Text="Góc lệch đứng tối đa (độ):" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBox x:Name="tb_angle" Text="1" Width="50" Margin="6,0,0,0"/>
        </StackPanel>
        <CheckBox x:Name="chk_draw" Margin="0,8,0,8"
                  Content="Sau khi quét: vẽ Detail Line vùng quét + hình chiếu đối tượng bị bắt (Ctrl+Z để xoá)"/>

        <TextBlock Text="6. Revision Cloud" FontWeight="Bold"/>
        <CheckBox x:Name="chk_cloud" Margin="0,4,0,4"
                  Content="Tạo Revision Cloud quanh mỗi đối tượng bị bắt (trong active view)"/>
        <Grid IsEnabled="{Binding IsChecked, ElementName=chk_cloud}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Revision (type cloud):"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cb_revision" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cloud type:"
                       VerticalAlignment="Center" Margin="0,4,8,0"/>
            <ComboBox x:Name="cb_cloudtype" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Kích thước (mm):"
                       VerticalAlignment="Center" Margin="0,4,8,0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Offset quanh đối tượng" VerticalAlignment="Center"/>
                <TextBox x:Name="tb_cloud_offset" Text="300" Width="60" Margin="6,0,0,0"/>
                <TextBlock Text="Cạnh tối thiểu" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBox x:Name="tb_cloud_min" Text="600" Width="60" Margin="6,0,0,0"/>
                <CheckBox x:Name="chk_cloud_merge" Content="Gộp đối tượng chồng nhau thành 1 cloud"
                          IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btn_run" Content="Quét" Width="90" IsDefault="True"/>
            <Button x:Name="btn_cancel" Content="Đóng" Width="90" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
