<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash Check - Active Model vs Link" Width="1200" Height="560"
        MinWidth="950" MinHeight="480" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. ACTIVE MODEL -->
            <GroupBox Grid.Column="0" Header="1. Active model - categories to scan" Margin="0,0,6,0" Padding="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Add category:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                            <Button x:Name="btn_add_cat" Content="+ Add" Padding="10,2" Margin="6,0,0,0" DockPanel.Dock="Right"/>
                            <ComboBox x:Name="cb_add_cat" IsTextSearchEnabled="True" MaxDropDownHeight="350"
                                      ToolTip="Open the list to load all model categories that have elements in the active model"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton x:Name="rb_scope_model" Content="Entire model" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rb_scope_view" Content="Active view only" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rb_scope_sel" Content="Current selection" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="btn_act_all" Content="Check all" Padding="8,2" Margin="0,0,6,0"/>
                            <Button x:Name="btn_act_none" Content="Check none" Padding="8,2"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="#FFBBBBBB">
                        <StackPanel x:Name="sp_active" Margin="4"/>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <!-- 2. LINKS -->
            <GroupBox Grid.Column="1" Header="2. Link models" Margin="0,0,6,0" Padding="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="btn_links_all" Content="Check all" Padding="8,2" Margin="0,0,6,0"/>
                        <Button x:Name="btn_links_none" Content="Check none" Padding="8,2"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="#FFBBBBBB">
                        <StackPanel x:Name="sp_links" Margin="4"/>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <!-- 3. LINK CATEGORIES -->
            <GroupBox Grid.Column="2" Header="3. Link categories (from checked links)" Padding="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="btn_lc_all" Content="Check all" Padding="8,2" Margin="0,0,6,0"/>
                        <Button x:Name="btn_lc_none" Content="Check none" Padding="8,2"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="#FFBBBBBB">
                        <StackPanel x:Name="sp_linkcats" Margin="4"/>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Min. overlap volume (cm3, 0 = fast mode):" VerticalAlignment="Center"/>
            <TextBox x:Name="tb_minvol" Text="1" Width="60" Margin="6,0,18,0" VerticalContentAlignment="Center"/>
            <Button x:Name="btn_scan" Content="Scan clashes" Width="120" Height="28" FontWeight="Bold" Margin="0,0,8,0"/>
            <Button x:Name="btn_cancel" Content="Cancel" Width="80" Height="28" IsEnabled="False" Margin="0,0,8,0"/>
            <Button x:Name="btn_reset" Content="Reset settings" Height="28" Padding="10,0"
                    ToolTip="Forget saved settings and go back to defaults"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,8,0,4">
            <ProgressBar x:Name="pb" Height="14" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="txt_status" Text="Ready." Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button x:Name="btn_close" Content="Close" Padding="10,3" DockPanel.Dock="Right"/>
            <TextBlock Text="Settings are saved automatically. Results are printed to the pyRevit output window (click an ID to select / zoom)."
                       Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
