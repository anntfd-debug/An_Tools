<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Place Model Groups By Detail Groups"
        Width="850"
        Height="880"
        MinWidth="760"
        MinHeight="700"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="ĐẶT MODEL GROUP THEO DETAIL GROUP TRONG ACTIVE VIEW"
                       FontSize="17"
                       FontWeight="Bold"/>
            <TextBlock x:Name="active_view_text"
                       Margin="0,5,0,0"
                       FontWeight="SemiBold"
                       Foreground="#3F6387"/>
            <TextBlock x:Name="detail_group_total_text"
                       Margin="0,3,0,0"
                       Foreground="#666666"/>
            <TextBlock Margin="0,4,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       Text="Detail Group trong Active View được dùng làm anchor. Chọn Model Group Type; nếu Type có nhiều instance, Pick trực tiếp một Model Group mẫu. Tool học vị trí/góc của mẫu rồi lặp lại cho các Detail Group đích."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <GroupBox Header="1. Model Group cần đặt và Model Group mẫu" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="205"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Margin="0,5,10,10"
                                   Text="Model Group Type cần đặt:"/>
                        <ComboBox x:Name="group_combo"
                                  Grid.Row="0" Grid.Column="1"
                                  Margin="0,0,0,10"
                                  MinHeight="28"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Model Group mẫu:"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="165"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="sample_group_text"
                                     Grid.Column="0"
                                     Margin="0,0,8,0"
                                     MinHeight="28"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Text="Chưa chọn Model Group mẫu"/>
                            <Button x:Name="pick_sample_group_button"
                                    Grid.Column="1"
                                    MinHeight="28"
                                    Content="Pick Model Group mẫu"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Margin="0,0,0,4"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"
                                   Text="Nếu Type chỉ có 1 instance, tool tự chọn. Nếu có nhiều instance, Pick trực tiếp đúng group mẫu; không xổ toàn bộ instance nữa."/>

                        <TextBlock x:Name="sample_group_status"
                                   Grid.Row="3" Grid.Column="1"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="2. Chọn Detail Group đích - 2 Option" Margin="0,0,0,12">
                    <StackPanel Margin="12">
                        <RadioButton x:Name="mode_name_radio"
                                     GroupName="TargetMode"
                                     FontWeight="SemiBold"
                                     Content="Option 1 - Lọc theo Contains của tên Detail Group"/>
                        <Grid Margin="24,8,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,5,10,0"
                                       Text="Name Contains:"/>
                            <TextBox x:Name="detail_name_contains_text"
                                     Grid.Column="1"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Margin="24,-5,0,13"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"
                                   Text="Có thể nhập nhiều chuỗi bằng dấu ;  Ví dụ: WC; Toilet; Typical. Các chuỗi dùng OR. Tool tìm theo tên Detail Group Type."/>

                        <Border Height="1" Background="#DDDDDD" Margin="0,0,0,12"/>

                        <RadioButton x:Name="mode_geometry_radio"
                                     GroupName="TargetMode"
                                     FontWeight="SemiBold"
                                     Content="Option 2 - Pick 1 Detail Group và quét các Detail Group có hình học tương tự"/>

                        <Grid Margin="24,9,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="pick_detail_button"
                                    Grid.Column="0"
                                    Width="155"
                                    Height="31"
                                    HorizontalAlignment="Left"
                                    Content="Pick Detail Group"/>
                            <TextBlock x:Name="picked_detail_status"
                                       Grid.Column="1"
                                       Margin="10,5,0,0"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="24,6,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,5,10,0"
                                       Text="Dung sai so hình học (mm):"/>
                            <TextBox x:Name="geometry_tolerance_text"
                                     Grid.Column="1"
                                     MinHeight="27"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Margin="10,5,0,0"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       Text="Mặc định 2 mm. So category + bbox + curve geometry trong local coordinates của Group."/>
                        </Grid>

                        <Border Margin="0,5,0,0"
                                Padding="10"
                                Background="#EEF5FC"
                                BorderBrush="#83A9CC"
                                BorderThickness="1"
                                CornerRadius="3">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="Cách xác định Detail Group mẫu để học offset/góc:"/>
                                <TextBlock Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Text="Option 1: trong các Detail Group khớp tên, tool tự lấy Detail Group gần Model Group mẫu nhất.  Option 2: chính Detail Group bạn Pick là Detail Group mẫu."/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,11,0,0" Orientation="Horizontal">
                            <Button x:Name="scan_button"
                                    Width="170"
                                    Height="31"
                                    Content="Quét Detail Group đích"/>
                            <TextBlock x:Name="match_count_text"
                                       Margin="12,7,0,0"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3. Hiệu chỉnh thêm và chống tạo trùng" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Hiệu chỉnh theo trục X Detail Group (± mm):"/>
                        <TextBox x:Name="extra_offset_x_text"
                                 Grid.Row="0" Grid.Column="1"
                                 Margin="0,0,10,8"
                                 MinHeight="27"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Margin="0,5,0,8"
                                   Foreground="#777777"
                                   Text="Cộng thêm vào offset học từ mẫu"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Hiệu chỉnh theo trục Y Detail Group (± mm):"/>
                        <TextBox x:Name="extra_offset_y_text"
                                 Grid.Row="1" Grid.Column="1"
                                 Margin="0,0,10,8"
                                 MinHeight="27"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Margin="0,5,0,8"
                                   Foreground="#777777"
                                   Text="Cộng thêm vào offset học từ mẫu"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Hiệu chỉnh thêm góc Model Group (độ):"/>
                        <TextBox x:Name="extra_rotation_text"
                                 Grid.Row="2" Grid.Column="1"
                                 Margin="0,0,10,8"
                                 MinHeight="27"
                                 VerticalContentAlignment="Center"/>

                        <CheckBox x:Name="skip_duplicate_checkbox"
                                  Grid.Row="3" Grid.ColumnSpan="3"
                                  Margin="0,3,0,8"
                                  Content="Bỏ qua Model Group cùng Type đã có gần vị trí cần đặt"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Margin="24,5,10,0"
                                   Text="Dung sai kiểm tra Model Group trùng (mm):"/>
                        <TextBox x:Name="duplicate_tolerance_text"
                                 Grid.Row="4" Grid.Column="1"
                                 MinHeight="27"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="4. Chạy thử" Margin="0,0,0,8">
                    <Border Margin="12"
                            Padding="10"
                            Background="#FFF5D9"
                            BorderBrush="#E1B84A"
                            BorderThickness="1"
                            CornerRadius="3">
                        <StackPanel>
                            <CheckBox x:Name="test_one_checkbox"
                                      FontWeight="SemiBold"
                                      Content="Chỉ tạo Model Group cho 1 Detail Group để kiểm tra"/>
                            <Grid Margin="24,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="test_index_label"
                                           Grid.Column="0"
                                           Margin="0,5,8,0"
                                           Text="Chọn Detail Group thứ:"/>
                                <TextBox x:Name="test_index_text"
                                         Grid.Column="1"
                                         MinHeight="27"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="test_index_hint"
                                           Grid.Column="2"
                                           Margin="10,5,0,0"
                                           Foreground="#777777"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <TextBlock Margin="2,7,2,0"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Text="Cancel trong lúc đặt sẽ rollback toàn bộ lần chạy. Detail Group chỉ là anchor; đối tượng được tạo vẫn là Model Group Type đã chọn ở mục 1."/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#777777"
                       TextWrapping="Wrap"
                       Text="Báo cáo pyRevit sẽ liệt kê Detail Group đích và Model Group đã tạo."/>
            <Button x:Name="cancel_button"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Height="35"
                    Content="Đóng"
                    IsCancel="True"/>
            <Button x:Name="run_button"
                    Grid.Column="2"
                    Height="35"
                    Content="Bắt đầu"
                    IsDefault="True"
                    FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
