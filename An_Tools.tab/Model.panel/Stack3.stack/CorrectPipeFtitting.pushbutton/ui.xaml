<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Correct Pipes &amp; Fittings V5.8.5 Dual Mode - Revit 2025/2026"
        Height="900" Width="1180" MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="210" MinHeight="130"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <Border Background="#EEF6FF" BorderBrush="#B7D7F2" BorderThickness="1" Padding="10" Margin="0,0,0,9">
                    <StackPanel>
                        <TextBlock Text="Correct Pipes &amp; Fittings — Dual Mode" FontSize="17" FontWeight="Bold" Foreground="#0B4778"/>
                        <TextBlock Text="V5.8.5 Universal / Revit 2025-2026: System Type Lock + Dual Mode + Size Range. Tool khóa System Type của Pipe trước/sau mọi thay đổi; mixed-system fitting mặc định được bỏ qua. Tê/Wye giảm kiểm tra size theo RUN/BRANCH; isolated fallback và Transition Native ChangeTypeId vẫn được giữ." TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3FAF3" BorderBrush="#9CC59C" BorderThickness="1" Padding="9" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ĐỐI TƯỢNG ĐÃ CHỌN TRƯỚC KHI MỞ TOOL" FontWeight="Bold" Foreground="#276327"/>
                        <TextBlock x:Name="txt_PreselectionStatus" Text="Đang đọc selection..." Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="1. System Type cần xử lý:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmb_Systems" Height="30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="2. Pipe Type mới:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmb_PipeTypes" Height="30" SelectionChanged="pipe_type_selection_changed"/>
                    </StackPanel>
                </Grid>

                <GroupBox Header="3. Giới hạn Pipe Size được xử lý" FontWeight="Bold" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Min Pipe Size:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmb_MinPipeSize" Height="30" SelectionChanged="min_pipe_size_selection_changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max Pipe Size:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmb_MaxPipeSize" Height="30" SelectionChanged="max_pipe_size_selection_changed"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" x:Name="txt_PipeSizeRangeStatus" Text="Đang đọc các Pipe size trong model..."
                                   Margin="0,7,0,0" TextWrapping="Wrap" FontWeight="Normal"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="4. Chế độ chọn Fitting — chỉ được tick 1 trong 2" FontWeight="Bold" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <CheckBox x:Name="chk_ModeAutoRouting" IsChecked="True" Click="fitting_mode_click"
                                      Content="Option 1 — Auto Routing Preferences (như V5.5)" FontWeight="Bold" Margin="0,0,28,5"/>
                            <CheckBox x:Name="chk_ModeManualFittings" IsChecked="False" Click="fitting_mode_click"
                                      Content="Option 2 — Chọn Fitting thủ công (như V5.3)" FontWeight="Bold" Foreground="#8A5200" Margin="0,0,0,5"/>
                        </WrapPanel>
                        <TextBlock x:Name="txt_FittingModeStatus" Text="CHẾ ĐỘ 1 — Auto Routing: FamilySymbol được lấy tự động từ Routing Preferences của Pipe Type mới."
                                   Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#555555" FontWeight="Normal"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="panel_AutoRouting" Header="Option 1 — Routing Preferences tự động của Pipe Type mới"
                          FontWeight="Bold" Margin="0,0,0,10" Visibility="Visible">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="170"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Tool đọc rule theo thứ tự Routing Preferences. Với mỗi fitting, nhóm và Primary Size được xác định tự động; người dùng không cần chọn FamilySymbol." TextWrapping="Wrap" FontWeight="Normal" Foreground="#555555" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="1" x:Name="txt_RoutingSummary" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Background="#FAFAFA"/>
                    </Grid>
                </GroupBox>

                <Grid x:Name="panel_ManualFittings" Visibility="Collapsed" Height="340" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Option 2 — Fitting thường: tối đa 1 type / PartType" FontWeight="Bold">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="150"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Normal"/>
                                <Button x:Name="btn_ClearFilter" Content="Xóa" Width="48" Height="24" DockPanel.Dock="Right" Margin="6,0,0,0" Click="clear_filter_click"/>
                                <Button x:Name="btn_ClearSelectedFittings" Content="Bỏ chọn" Width="66" Height="24" DockPanel.Dock="Right" Margin="6,0,0,0" Click="clear_selected_fittings_click"/>
                                <TextBox x:Name="txt_FilterFittings" Height="24" TextChanged="filter_fittings_text_changed"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" x:Name="txt_FittingCount" FontWeight="Normal" Text="Đang đọc Pipe Fitting..." Foreground="#6A6A6A" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <ListBox Grid.Row="2" x:Name="lst_FittingTypes" FontWeight="Normal" SelectionMode="Multiple"
                                     SelectionChanged="fitting_selection_changed"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Option 2 — Fitting giảm: tối đa 1 type / PartType" FontWeight="Bold" BorderBrush="#D18A00">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="150"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Normal"/>
                                <Button x:Name="btn_ClearReducingFilter" Content="Xóa" Width="48" Height="24" DockPanel.Dock="Right" Margin="6,0,0,0" Click="clear_reducing_filter_click"/>
                                <Button x:Name="btn_ClearSelectedReducingFittings" Content="Bỏ chọn" Width="66" Height="24" DockPanel.Dock="Right" Margin="6,0,0,0" Click="clear_selected_reducing_fittings_click"/>
                                <TextBox x:Name="txt_FilterReducingFittings" Height="24" TextChanged="filter_reducing_fittings_text_changed"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" x:Name="txt_ReducingFittingCount" FontWeight="Normal" Text="Đang đọc Pipe Fitting giảm..." Foreground="#9A4D00" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <ListBox Grid.Row="2" x:Name="lst_ReducingFittingTypes" FontWeight="Normal" SelectionMode="Multiple"
                                     SelectionChanged="reducing_fitting_selection_changed"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </GroupBox>
                </Grid>

                <Border Background="#FFF8E8" BorderBrush="#E1B65A" BorderThickness="1" Padding="9" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Foreground="#8A5200" Text="Quy tắc V5.8.5:"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="• Option 1: Pipe Type mới quyết định fitting qua Routing Preferences.&#x0a;• Option 2: người dùng chỉ định đúng FamilySymbol đã load sẵn trong project; mỗi PartType tối đa 1 type. Không còn Nạp Family/Reload Family trong UI.&#x0a;• Transition/Reducer: dùng Native Revit ChangeTypeId trực tiếp trên fitting hiện hữu; không recreate, không auto-size, không rotate/flip và không trim/extend ống.&#x0a;• Các PartType khác tiếp tục dùng centerline alignment, auto-size, reconnect và rollback từng fitting khi cần.&#x0a;• SYSTEM TYPE LOCK luôn bật: Pipe Type/Fitting Type có thể đổi nhưng System Type của Pipe không được phép thay đổi.&#x0a;• Cả hai Option đều dùng chung Min/Max Pipe Size."/>
                    </StackPanel>
                </Border>

                <GroupBox Header="5. Bảo vệ System Type V5.8.5 — SYSTEM TYPE LOCK luôn bật" FontWeight="Bold" Margin="0,0,0,10" BorderBrush="#B64040">
                    <StackPanel Margin="8">
                        <TextBlock Text="Tool chỉ được đổi Pipe Type / Fitting Type. System Type của từng Pipe phải giữ nguyên tuyệt đối trước và sau thao tác; nếu Revit tự tái gán System Type, SubTransaction sẽ rollback."
                                   TextWrapping="Wrap" Foreground="#8A1F1F" FontWeight="Bold"/>
                        <CheckBox x:Name="chk_SkipMixedSystemFittings" IsChecked="True" Margin="0,8,0,0"
                                  Content="Bỏ qua fitting đang nối trực tiếp các Pipe thuộc nhiều System Type (khuyến nghị)"
                                  Foreground="#8A1F1F" FontWeight="Bold"/>
                        <TextBlock Margin="22,4,0,0" TextWrapping="Wrap" Foreground="#666666"
                                   Text="Nếu bỏ tick, tool được phép xử lý thử mixed-system fitting nhưng vẫn snapshot System Type của từng Pipe partner. Chỉ cần một Pipe đổi System Type là fitting đó rollback; trước khi commit toàn batch còn có một lớp kiểm tra System Type lần cuối."/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Margin="0,0,0,2">
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="chk_ReplacePipes" Content="Thay Pipe" IsChecked="True" Margin="0,0,22,5"/>
                        <CheckBox x:Name="chk_ReplaceFittings" Content="Thay Fitting" IsChecked="True" FontWeight="Bold" Margin="0,0,22,5"/>
                        <CheckBox x:Name="chk_ForceReconnectFittings" Content="Fallback: ngắt/nối lại fitting bị lỗi" IsChecked="True" FontWeight="Bold" Foreground="#9A4D00" Margin="0,0,22,5"/>
                    </WrapPanel>
                    <TextBlock Text="Không hiện popup kết quả nhỏ sau khi chạy. Thành công / bỏ qua / lỗi được ghi đầy đủ trong Log." Foreground="#6A6A6A" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#D0D0D0"
                      ShowsPreview="True" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      ToolTip="Kéo lên/xuống để thay đổi chiều cao vùng cài đặt và log"/>

        <GroupBox Grid.Row="2" Header="Log kết quả — Mode / Size Range / thành công / bỏ qua / lỗi" FontWeight="Bold">
            <TextBox x:Name="txt_Log" Margin="8" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" FontWeight="Normal"/>
        </GroupBox>

        <Button Grid.Row="4" x:Name="btn_Replace" Content="Thực hiện — System Type Lock + Dual Mode" Height="44"
                FontWeight="Bold" FontSize="14" Background="#007ACC" Foreground="White" Click="replace_click"/>
    </Grid>
</Window>
