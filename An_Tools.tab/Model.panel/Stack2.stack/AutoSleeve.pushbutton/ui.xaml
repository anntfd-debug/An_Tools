<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Sleeve | Multi Pick Link"
        Width="860" Height="760" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F8">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#17324D" Padding="22,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AUTO PLACE SLEEVE" Foreground="White"
                               FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Chọn MEP → pick nhiều link → chọn Wall/Floor/Beam → đặt sleeve"
                               Foreground="#CFE1F2" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#234A6D" CornerRadius="16"
                        Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="Nested Link Ready" Foreground="#D9F2E6" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="18">
            <StackPanel>

                <!-- Mapping -->
                <Border Background="White" CornerRadius="9" Padding="16" Margin="0,0,0,13">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="1. ÁNH XẠ KÍCH THƯỚC SLEEVE"
                                           Foreground="#17324D" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Name="TxtSizeSummary"
                                           Text="Đang quét toàn bộ Pipe trong model..."
                                           Foreground="#64748B" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Required diameter = đường kính ống + 2 × chiều dày cách nhiệt. Danh sách size vẫn cho phép gõ số bằng tay."
                                           Foreground="#64748B" FontSize="11" Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Name="BtnAddRow" Content="＋ Thêm dòng"
                                    Background="#E7F0F8" Foreground="#17324D"
                                    BorderBrush="#BDD1E3" Height="32"/>
                        </Grid>

                        <StackPanel Name="MappingContainer"/>
                    </StackPanel>
                </Border>

                <!-- Link picker -->
                <Border Background="White" CornerRadius="9" Padding="16" Margin="0,0,0,13">
                    <StackPanel>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="2. PICK REVIT LINK"
                                           Foreground="#17324D" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Name="TxtLinkSummary" Text="0 link gốc · 0 nested link"
                                           Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Name="BtnPickLinks" Content="⌖  PICK NHIỀU LINK"
                                    Height="34" Margin="8,0,7,0"
                                    Background="#0F6CBD" Foreground="White"
                                    BorderBrush="#0F6CBD" FontWeight="SemiBold"/>
                            <Button Grid.Column="2" Name="BtnClearLinks" Content="Bỏ chọn tất cả"
                                    Height="34" Background="#F8FAFC" Foreground="#475569"
                                    BorderBrush="#CBD5E1"/>
                        </Grid>

                        <Border BorderBrush="#C8D6E4" BorderThickness="1" CornerRadius="7"
                                Background="#F7FAFD" Padding="9" MinHeight="130" MaxHeight="245">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="LinkContainer"/>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="Khi nhấn Pick: giao diện sẽ đóng tạm, chọn nhiều Revit Link trong model rồi nhấn Finish trên Options Bar. Giao diện sẽ tự mở lại và hiện đầy đủ link cha/nested link."
                                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
                                   Margin="2,8,2,0"/>
                    </StackPanel>
                </Border>

                <!-- Host categories -->
                <Border Background="White" CornerRadius="9" Padding="16" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="3. ĐỐI TƯỢNG KẾT CẤU CẦN QUÉT"
                                   Foreground="#17324D" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Có thể chọn Wall, Floor và Structural Framing riêng lẻ hoặc đồng thời."
                                   Foreground="#64748B" Margin="0,4,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#D8E2EC"
                                    BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,6,0">
                                <CheckBox Name="ChkWall" IsChecked="True">
                                    <StackPanel>
                                        <TextBlock Text="Wall" FontWeight="SemiBold" Foreground="#17324D"/>
                                        <TextBlock Text="Quét MEP xuyên tường"
                                                   FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#D8E2EC"
                                    BorderThickness="1" CornerRadius="7" Padding="13" Margin="6,0,6,0">
                                <CheckBox Name="ChkFloor" IsChecked="True">
                                    <StackPanel>
                                        <TextBlock Text="Floor" FontWeight="SemiBold" Foreground="#17324D"/>
                                        <TextBlock Text="Quét MEP xuyên sàn"
                                                   FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#D8E2EC"
                                    BorderThickness="1" CornerRadius="7" Padding="13" Margin="6,0,0,0">
                                <CheckBox Name="ChkBeam" IsChecked="False">
                                    <StackPanel>
                                        <TextBlock Text="Structural Framing" FontWeight="SemiBold" Foreground="#17324D"/>
                                        <TextBlock Text="Mặt đứng như Wall · mặt ngang như Floor"
                                                   FontSize="11" Foreground="#64748B" Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Duplicate options -->
                <Border Background="White" CornerRadius="9" Padding="16">
                    <StackPanel>
                        <TextBlock Text="4. XỬ LÝ SLEEVE TRÙNG"
                                   Foreground="#17324D" FontWeight="Bold" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton Name="RbSkip" Content="Giữ sleeve hiện có và bỏ qua" IsChecked="True"
                                         Margin="0,0,28,0"/>
                            <RadioButton Name="RbReplace" Content="Xóa sleeve cũ và đặt lại sleeve mới"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Name="TxtValidation" Foreground="#B42318" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="4,10,4,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D5DEE8"
                BorderThickness="0,1,0,0" Padding="18,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Kết quả sẽ xuất thêm ElementId có thể click/zoom trong pyRevit Output."
                           VerticalAlignment="Center" Foreground="#64748B"/>
                <Button Grid.Column="1" Name="BtnCancel" Content="Hủy" Width="95" Height="36"
                        Margin="0,0,9,0" Background="#F8FAFC" Foreground="#475569"
                        BorderBrush="#CBD5E1"/>
                <Button Grid.Column="2" Name="BtnRun" Content="CHẠY AUTO SLEEVE" Width="175" Height="36"
                        Background="#17324D" Foreground="White" BorderBrush="#17324D"
                        FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
