<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Place Group From Families (Link / Host)"
        Width="800"
        Height="960"
        MinWidth="720"
        MinHeight="760"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="ĐẶT MODEL GROUP THEO FAMILY (REVIT LINK / MODEL HIỆN TẠI)"
                       FontSize="17" FontWeight="Bold"/>
            <TextBlock x:Name="active_view_text"
                       Margin="0,5,0,0"
                       FontWeight="SemiBold"
                       Foreground="#3F6387"/>
            <TextBlock Margin="0,4,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       Text="Chỉ xử lý Family đang hiển thị trong Active View. Nguồn Family có thể là Revit Link hoặc Model hiện tại; chỉ khi cần dùng Link mới phải bấm Pick Revit Link, nếu không cần Link thì dùng Pick Family hoặc Lọc từ khóa / Chọn theo Type trực tiếp. Danh sách nguồn vẫn được loại nested Family và nguồn chồng vị trí trước khi tạo Group."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="1. Nguồn Family, Group và cách chọn Family" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: nguồn Family -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   FontWeight="SemiBold"
                                   Text="Nguồn Family:"/>
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="0,2,0,8">
                            <RadioButton x:Name="source_link_radio"
                                         GroupName="SourceDocument"
                                         Margin="0,3,22,0"
                                         Content="Family trong Revit Link"/>
                            <RadioButton x:Name="source_host_radio"
                                         GroupName="SourceDocument"
                                         Margin="0,3,0,0"
                                         Content="Family trong Model hiện tại"/>
                        </StackPanel>

                        <!-- Row 1: Revit Link (chỉ pick khi cần) -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Các Revit Link đã chọn:"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="links_list"
                                     Grid.Column="0"
                                     Height="70"
                                     IsHitTestVisible="False"
                                     Focusable="False"/>
                            <Button x:Name="pick_links_button"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Height="30"
                                    VerticalAlignment="Top"
                                    Content="Pick Revit Link"/>
                        </Grid>

                        <!-- Row 2: Group Type -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Margin="0,5,10,10"
                                   Text="Model Group Type:"/>
                        <ComboBox x:Name="group_combo"
                                  Grid.Row="2" Grid.Column="1"
                                  Margin="0,0,0,10"
                                  MinHeight="28"/>

                        <!-- Row 3: cách chọn Family -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Cách chọn Family nguồn:"/>
                        <StackPanel Grid.Row="3" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="0,2,0,8">
                            <RadioButton x:Name="keyword_mode_radio"
                                         GroupName="SourceFilterMode"
                                         Margin="0,3,22,0"
                                         Content="Lọc bằng từ khóa"/>
                            <RadioButton x:Name="pick_mode_radio"
                                         GroupName="SourceFilterMode"
                                         Margin="0,3,22,0"
                                         Content="Pick Family"/>
                            <RadioButton x:Name="types_mode_radio"
                                         GroupName="SourceFilterMode"
                                         Margin="0,3,0,0"
                                         Content="Chọn theo Type"/>
                        </StackPanel>

                        <!-- Row 4: từ khóa -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Từ khóa Family / Type:"/>
                        <TextBox x:Name="filter_text"
                                 Grid.Row="4" Grid.Column="1"
                                 Height="80"
                                 MinHeight="60"
                                 Margin="0,0,0,8"
                                 Padding="6"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- Row 5: pick Family -->
                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Family đã pick:"/>
                        <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="pick_family_button"
                                    Grid.Column="0"
                                    Width="165" Height="30"
                                    HorizontalAlignment="Left"
                                    Content="Pick Family từ Link"/>
                            <TextBlock x:Name="picked_family_text"
                                       Grid.Column="1"
                                       Margin="10,5,0,0"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"
                                       Text="Chưa pick Family."/>
                        </Grid>

                        <!-- Row 6: khóa Type đã pick -->
                        <CheckBox x:Name="pick_exact_type_checkbox"
                                  Grid.Row="6" Grid.Column="1"
                                  Margin="0,0,0,10"
                                  Content="Chỉ lấy đúng Type đã pick (bỏ chọn = lấy tất cả Type của Family đó)"/>

                        <!-- Row 7: chọn theo Type -->
                        <TextBlock Grid.Row="7" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Danh sách Family Type:"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,10">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="type_search_text"
                                         Grid.Column="0"
                                         MinHeight="27"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Tìm nhanh trong danh sách Type (nhiều từ cách nhau bằng khoảng trắng)"/>
                                <Button x:Name="load_types_button"
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Padding="8,0"
                                        Height="27"
                                        Content="Nạp danh sách Type"/>
                                <Button x:Name="select_all_types_button"
                                        Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Padding="8,0"
                                        Height="27"
                                        Content="Chọn hết"/>
                                <Button x:Name="clear_types_button"
                                        Grid.Column="3"
                                        Margin="6,0,0,0"
                                        Padding="8,0"
                                        Height="27"
                                        Content="Bỏ chọn"/>
                            </Grid>
                            <ListBox x:Name="type_list"
                                     Height="190"
                                     SelectionMode="Multiple"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            <TextBlock x:Name="type_selection_text"
                                       Margin="0,5,0,0"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"
                                       Text="Chưa nạp danh sách Type."/>
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="#888888"
                                       TextWrapping="Wrap"
                                       Text="Hiển thị dạng Category | Family : Type (số lượng sơ bộ). Chế độ Chọn hết / Bỏ chọn chỉ áp dụng cho các dòng đang hiển thị theo ô tìm kiếm."/>
                        </StackPanel>

                        <!-- Row 8: kiểm tra -->
                        <StackPanel Grid.Row="8" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="0,2,0,0">
                            <Button x:Name="scan_button"
                                    Width="145" Height="30"
                                    Content="Kiểm tra số lượng"/>
                            <TextBlock x:Name="match_count_text"
                                       Margin="12,7,0,0"
                                       MaxWidth="420"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"
                                       Text="Chưa kiểm tra"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="2. Xử lý Family nguồn trùng" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="135"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="ignore_nested_checkbox"
                                  Grid.Row="0" Grid.ColumnSpan="2"
                                  Margin="0,0,0,8"
                                  FontWeight="SemiBold"
                                  Content="Bỏ qua nested Family có SuperComponent (khuyến nghị)"/>

                        <CheckBox x:Name="skip_group_member_checkbox"
                                  Grid.Row="1" Grid.ColumnSpan="2"
                                  Margin="0,0,0,8"
                                  FontWeight="SemiBold"
                                  Content="Bỏ qua Family đang nằm trong Model Group (chỉ áp dụng Model hiện tại, khuyến nghị)"/>

                        <CheckBox x:Name="source_dedup_checkbox"
                                  Grid.Row="2" Grid.ColumnSpan="2"
                                  Margin="0,0,0,8"
                                  FontWeight="SemiBold"
                                  Content="Loại Family nguồn cùng Category + Family + Type bị chồng vị trí"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Margin="24,5,10,8"
                                   Text="Dung sai nhận diện nguồn chồng vị trí (mm):"/>
                        <TextBox x:Name="source_overlap_tolerance_text"
                                 Grid.Row="3" Grid.Column="1"
                                 Margin="0,0,0,8"
                                 MinHeight="27"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                                   Margin="24,0,0,0"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"
                                   Text="Tool luôn loại bản ghi trùng theo Nguồn UniqueId + Family UniqueId. Dung sai trên dùng thêm để xử lý hai Link chồng nhau hoặc hai nguồn cùng loại gần như cùng một điểm."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="3. Cách xác định vị trí đặt Group" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <RadioButton x:Name="placement_anchor_radio"
                                         GroupName="PlacementMode"
                                         Margin="0,3,22,0"
                                         Content="Theo góc neo (Anchor) + Offset"/>
                            <RadioButton x:Name="placement_sample_radio"
                                         GroupName="PlacementMode"
                                         Margin="0,3,0,0"
                                         Content="Theo mẫu Group đã đặt (học vị trí + cao độ)"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                   Margin="0,0,0,8"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Text="LEFT/RIGHT theo HandOrientation; FRONT/BACK theo FacingOrientation của Family. Chỉ áp dụng ở chế độ Anchor."/>

                        <RadioButton x:Name="left_back_radio"
                                     Grid.Row="2" Grid.Column="0"
                                     Margin="5,5,20,8"
                                     GroupName="AnchorMode"
                                     Content="LEFT_BACK  (Trái - Sau)"/>
                        <RadioButton x:Name="right_back_radio"
                                     Grid.Row="2" Grid.Column="1"
                                     Margin="5,5,0,8"
                                     GroupName="AnchorMode"
                                     Content="RIGHT_BACK  (Phải - Sau)"/>
                        <RadioButton x:Name="left_front_radio"
                                     Grid.Row="3" Grid.Column="0"
                                     Margin="5,5,20,5"
                                     GroupName="AnchorMode"
                                     Content="LEFT_FRONT  (Trái - Trước)"/>
                        <RadioButton x:Name="right_front_radio"
                                     Grid.Row="3" Grid.Column="1"
                                     Margin="5,5,0,5"
                                     GroupName="AnchorMode"
                                     Content="RIGHT_FRONT  (Phải - Trước)"/>

                        <Border Grid.Row="4" Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Padding="9"
                                Background="#EAF2FB"
                                BorderBrush="#9FBEDC"
                                BorderThickness="1"
                                CornerRadius="3">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#444444"
                                           Margin="0,0,0,6"
                                           Text="Chế độ mẫu: pick một Model Group đã đặt đúng vị trí/cao độ, sau đó pick Family nguồn tương ứng. Tool tự tính Offset X/Y/Z và góc xoay lệch rồi điền vào mục 4 bên dưới, áp dụng đồng loạt cho mọi Family nguồn. Family dùng để học vị trí sẽ tự động bị loại khỏi danh sách đặt Group vì Group mẫu đã có sẵn tại đó."/>
                                <Button x:Name="learn_sample_button"
                                        Width="260" Height="30"
                                        HorizontalAlignment="Left"
                                        Content="Học vị trí từ Group mẫu..."/>
                                <TextBlock x:Name="sample_info_text"
                                           Margin="0,8,0,0"
                                           Foreground="#555555"
                                           TextWrapping="Wrap"
                                           Text="Chưa học vị trí mẫu."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>

                <GroupBox Header="4. Khoảng lệch và góc xoay" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="205"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5,10,8" Text="Offset theo X cục bộ (± mm):"/>
                        <TextBox x:Name="offset_x_text" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" MinHeight="27" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,5,0,8" Foreground="#777777" Text="+X = HandOrientation; -X = ngược lại"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,10,8" Text="Offset theo Y cục bộ (± mm):"/>
                        <TextBox x:Name="offset_y_text" Grid.Row="1" Grid.Column="1" Margin="0,0,10,8" MinHeight="27" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,5,0,8" Foreground="#777777" Text="+Y = FacingOrientation; -Y = ngược lại"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,10,8" Text="Offset theo Z - cao độ (± mm):"/>
                        <TextBox x:Name="offset_z_text" Grid.Row="2" Grid.Column="1" Margin="0,0,10,8" MinHeight="27" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,5,0,8" Foreground="#777777" Text="So với cao độ gốc của Family; +Z = lên cao"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,5,10,0" Text="Hiệu chỉnh góc Group (độ):"/>
                        <TextBox x:Name="rotation_offset_text" Grid.Row="3" Grid.Column="1" Margin="0,0,10,0" MinHeight="27" VerticalContentAlignment="Center"/>
                        <ComboBox x:Name="rotation_basis_combo" Grid.Row="3" Grid.Column="2" MinHeight="27"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="5. Chạy thử và kiểm soát Group" Margin="0,0,0,8">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="125"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                Padding="9"
                                Background="#FFF5D9"
                                BorderBrush="#E1B84A"
                                BorderThickness="1"
                                CornerRadius="3">
                            <StackPanel>
                                <CheckBox x:Name="test_one_checkbox"
                                          FontWeight="SemiBold"
                                          Content="Chỉ tạo 1 Group để kiểm tra góc và vị trí"/>
                                <Grid Margin="24,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="test_index_label"
                                               Grid.Column="0"
                                               Margin="0,5,8,0"
                                               Text="Chọn Family thứ:"/>
                                    <TextBox x:Name="test_index_text"
                                             Grid.Column="1"
                                             MinHeight="27"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="test_index_hint"
                                               Grid.Column="2"
                                               Margin="10,5,0,0"
                                               Foreground="#777777"
                                               TextWrapping="Wrap"
                                               Text="Nhập từ 1 đến tổng số Family đã kiểm tra"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="skip_duplicate_checkbox"
                                  Grid.Row="1" Grid.ColumnSpan="2"
                                  Margin="0,0,0,8"
                                  Content="Bỏ qua Group cùng Type đã có gần vị trí đặt"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Margin="24,5,10,8"
                                   Text="Dung sai kiểm tra Group đã có (mm):"/>
                        <TextBox x:Name="duplicate_tolerance_text"
                                 Grid.Row="2" Grid.Column="1"
                                 Margin="0,0,0,8"
                                 MinHeight="27"
                                 VerticalContentAlignment="Center"/>
                        <CheckBox x:Name="use_solid_checkbox"
                                  Grid.Row="3" Grid.ColumnSpan="2"
                                  Content="Dùng Solid để xác định góc chính xác (khuyến nghị; chậm hơn BoundingBox)"/>
                    </Grid>
                </GroupBox>

                <TextBlock Margin="2,7,2,0"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Text="Revit Link: cache bền chỉ hợp lệ khi Active View, Link, cách chọn Family, bộ lọc/Type và thiết lập chống trùng không đổi. Model hiện tại: luôn quét mới mỗi lần chạy. Giao diện luôn mở ngay; chỉ cần bấm Pick Revit Link khi thật sự dùng Link làm nguồn. Progress bar có nút Cancel; Cancel lúc đặt Group sẽ rollback toàn bộ lần chạy."/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#777777"
                       TextWrapping="Wrap"
                       Text="Báo cáo pyRevit sẽ liệt kê Group đã tạo và các nguồn Family bị loại vì trùng."/>
            <Button x:Name="cancel_button"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Height="35"
                    Content="Đóng"
                    IsCancel="True"/>
            <Button x:Name="run_button"
                    Grid.Column="2"
                    Height="35"
                    Content="Bắt đầu"
                    IsDefault="True"
                    FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
