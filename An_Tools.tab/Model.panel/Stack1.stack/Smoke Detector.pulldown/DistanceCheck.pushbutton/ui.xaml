<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Room Coverage Check"
    Width="590"
    Height="820"
    MinHeight="760"
    SizeToContent="Manual"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="#F5F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Room Filled Region / Coverage"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#202124" />
            <TextBlock Margin="0,6,0,15"
                       Text="Tạo Room Filled Region và kiểm tra Coverage là hai quá trình độc lập. Tạo xong sẽ dừng, không tự động chạy kiểm tra."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#666666" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14"
                Background="White"
                BorderBrush="#D8DCE3"
                BorderThickness="1"
                CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="1. Chọn quá trình chạy"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#303134"
                               Margin="0,0,0,9" />

                    <RadioButton x:Name="rbCreateRooms"
                                 GroupName="RunMode"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Content="A. Tạo Filled Region theo Room từ Revit Link - CHỈ TẠO"
                                 Margin="0,0,0,4" />
                    <TextBlock Margin="24,0,0,13"
                               TextWrapping="Wrap"
                               Foreground="#666666"
                               Text="Pick một hoặc nhiều Revit Link, đọc Room boundary và tạo Filled Region trên Active View. Hoàn thành bước này tool sẽ dừng, không quét Family và không kiểm tra Coverage." />

                    <RadioButton x:Name="rbCheckAutoRooms"
                                 GroupName="RunMode"
                                 IsChecked="True"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Content="B. Kiểm tra Coverage - dùng Room Filled Region đã tạo"
                                 Margin="0,0,0,4" />
                    <TextBlock Margin="24,0,0,13"
                               TextWrapping="Wrap"
                               Foreground="#666666"
                               Text="Không tạo Room mới. Tool tự lấy toàn bộ Filled Region Room do tool đã tạo trước đó trên Active View, sau đó mới quét Family và kiểm tra Coverage + khoảng cách tới boundary." />

                    <RadioButton x:Name="rbCheckExistingRegion"
                                 GroupName="RunMode"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Content="C. Kiểm tra Coverage - pick nhiều Filled Region có sẵn"
                                 Margin="0,0,0,4" />
                    <TextBlock Margin="24,0,0,14"
                               TextWrapping="Wrap"
                               Foreground="#666666"
                               Text="Không tạo Room mới. Pick một hoặc nhiều Filled Region làm vùng kiểm tra, sau đó nhấn Finish." />

                    <Separator Margin="0,2,0,12" />

                    <TextBlock Text="2. Filled Region Type cho Room"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#303134"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="cmbRoomRegionType"
                              Height="29"
                              MinWidth="430"
                              DisplayMemberPath="label"
                              Margin="0,0,0,5"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Margin="0,0,0,14"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#777777"
                               Text="Chỉ được dùng khi chạy chế độ A - Tạo Room Filled Region." />

                    <Separator Margin="0,0,0,12" />

                    <TextBlock Text="3. Thiết lập kiểm tra Coverage"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#303134"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Bán kính phủ"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#303134"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtCoverageRadius"
                                 Grid.Column="0"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Text="10000" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="mm"
                                   Foreground="#555555" />
                    </Grid>

                    <TextBlock Text="Khoảng cách tối đa từ Family lớp ngoài tới boundary"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#303134"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtWallDistance"
                                 Grid.Column="0"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Text="5000" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="mm"
                                   Foreground="#555555" />
                    </Grid>

                    <TextBlock Text="Filled Region Type cho VÙNG KHÔNG PHỦ - chỉ FAIL"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#303134"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="cmbCoverageRegionType"
                              Height="29"
                              MinWidth="430"
                              DisplayMemberPath="label"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="Filled Region Type cho lỗi khoảng cách boundary - chỉ FAIL"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#303134"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="cmbResultRegionType"
                              Height="29"
                              MinWidth="430"
                              DisplayMemberPath="label"
                              HorizontalAlignment="Stretch" />

                    <Border Margin="0,15,0,0"
                            Padding="10"
                            Background="#F7F8FA"
                            BorderBrush="#E2E5EA"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#555555"
                                   Text="Chế độ B/C mới quét Family. Tool dùng bán kính R để tính coverage nhưng KHÔNG vẽ vòng tròn quanh Family. Chỉ phần diện tích thực tế chưa được bất kỳ bán kính nào phủ mới được tạo Filled Region. Family lớp ngoài chỉ kiểm tra khoảng cách gần nhất tới boundary; chỉ khi vượt giá trị khoảng cách tối đa nhập ở trên mới vẽ marker rộng 300 mm." />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="btnCancel"
                    Content="Hủy"
                    Width="88"
                    Height="31"
                    Margin="0,0,9,0"
                    Click="btnCancel_Click" />
            <Button x:Name="btnRun"
                    Content="Chạy"
                    Width="95"
                    Height="31"
                    IsDefault="True"
                    Click="btnRun_Click" />
        </StackPanel>
    </Grid>
</Window>
