+class LinkedDoorSelectionFilter(ISelectionFilter):
+    # ObjectType.LinkedElement passes the RevitLinkInstance to AllowElement.
+    # Keep that instance for AllowReference, following the Revit API pattern.
+    def __init__(self):
+        self.current_link_instance = None
+
+    def AllowElement(self, element):
+        if isinstance(element, DB.RevitLinkInstance):
+            self.current_link_instance = element
+            return True
+        self.current_link_instance = None
+        return False
+
+    def AllowReference(self, reference, point):
+        try:
+            link_instance = self.current_link_instance
+            if link_instance is None:
+                link_instance = doc.GetElement(reference.ElementId)
+            if not isinstance(link_instance, DB.RevitLinkInstance):
+                return False
+            link_doc = link_instance.GetLinkDocument()
+            if link_doc is None:
+                return False
+            linked_id = reference.LinkedElementId
+            if linked_id is None or linked_id == DB.ElementId.InvalidElementId:
+                return False
+            linked_element = link_doc.GetElement(linked_id)
+            if linked_element is None or linked_element.Category is None:
+                return False
+            return linked_element.Category.Id == DB.ElementId(DB.BuiltInCategory.OST_Doors)
+        except Exception:
+            return False
+
+
