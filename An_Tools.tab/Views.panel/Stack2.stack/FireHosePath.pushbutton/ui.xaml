<?xml version="1.0" encoding="utf-8"?>
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fire Cabinet Coverage Routes"
    Width="590"
    Height="820"
    MinWidth="540"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="#F5F7F9"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#B8C0C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#B8C0C8"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2B3137"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Only the settings area scrolls. The error message and action buttons
             remain visible at the bottom on small or high-DPI displays. -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True"
                      Padding="0,0,8,0">
            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Fire Cabinet Compartment Routes"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#1E3A5F"/>
                    <TextBlock Margin="0,5,0,0"
                               Text="Choose Rebuild for an automatic compartment run, or Add New to pick target points without a required order. Each point is assigned to its nearest reachable cabinet."
                               TextWrapping="Wrap"
                               Foreground="#5C6670"/>
                </StackPanel>

                <Border Padding="16"
                        Margin="0,0,0,14"
                        Background="White"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Maximum FHR travel distance (m)"/>
                            <TextBox x:Name="max_distance_tb"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Grid size (mm)"/>
                            <TextBox x:Name="grid_size_tb"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Obstacle clearance (mm)"/>
                            <TextBox x:Name="clearance_tb"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="35 m checkpoint / uncovered marker size (mm)"/>
                            <TextBox x:Name="endpoint_marker_tb"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Path of Travel and diagnostic marker Line style"/>
                            <ComboBox x:Name="line_style_cb"/>
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="#687078"
                                       TextWrapping="Wrap"
                                       Text="The selected Line style is applied directly to generated routes and markers. The tool does not require an existing or sample Path of Travel. Endpoint plus markers are not created; plus markers are used only at 35 m on routes longer than 35 m."/>

                            <TextBlock Margin="0,14,0,5"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Update mode"/>
                            <RadioButton x:Name="full_rebuild_rb"
                                         GroupName="RunMode"
                                         FontWeight="SemiBold"
                                         Content="1. Rebuild routes only in the selected compartment"/>
                            <TextBlock Margin="22,4,0,0"
                                       Foreground="#687078"
                                       TextWrapping="Wrap"
                                       Text="Full Rebuild is atomic. If any cabinet route fails, all changes are rolled back and every existing route is preserved."/>

                            <RadioButton x:Name="force_append_rb"
                                         GroupName="RunMode"
                                         Margin="0,10,0,0"
                                         FontWeight="SemiBold"
                                         Content="2. Add new picked-point route and keep all existing routes"/>
                            <TextBlock Margin="22,4,0,8"
                                       Foreground="#687078"
                                       TextWrapping="Wrap"
                                       Text="After selecting this mode and pressing Run, pick one or more target points in any order and press Esc to finish. Each point is assigned to its nearest reachable cabinet by walkable route distance. The tool optimizes the visit order, keeps every existing Path of Travel, and stops at the last point reached."/>

                            <CheckBox x:Name="uncovered_marker_cb"
                                      Margin="0,10,0,0"
                                      FontWeight="SemiBold"
                                      Content="Create diamond markers at uncovered cluster centres"/>
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="#687078"
                                       TextWrapping="Wrap"
                                       Text="Rebuild runs automatically after the settings window closes. Add New opens the point-picking loop only after the selected Filled Region and settings have been confirmed."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="16"
                        Background="White"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="auto_scan_cb"
                                  Grid.Row="0"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="#23384D"
                                  Content="Automatically scan FHR cabinets inside the compartment"/>

                        <Border x:Name="keyword_panel"
                                Grid.Row="2"
                                Padding="13"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Text in Family / Type / Name"/>
                                <TextBlock x:Name="keyword_hint"
                                           Grid.Row="1"
                                           Margin="0,0,0,8"
                                           Foreground="#687078"
                                           TextWrapping="Wrap"
                                           Text="Host model only. Separate by comma, semicolon or new line. One keyword match is enough. Category, Mark and Description are also checked."/>
                                <TextBox x:Name="keyword_tb"
                                         Grid.Row="2"
                                         MinHeight="92"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="keyword_status"
                                           Grid.Row="3"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="error_text"
                       Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="#C62828"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="cancel_btn"
                        Content="Cancel"
                        Background="#E9ECEF"
                        BorderBrush="#C8CDD2"/>
                <Button x:Name="run_btn"
                        Content="Run"
                        Foreground="White"
                        Background="#1769AA"
                        BorderBrush="#105A91"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
