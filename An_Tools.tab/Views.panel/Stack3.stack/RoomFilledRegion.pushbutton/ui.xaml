<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Filled Region From Link"
        Width="620"
        Height="960"
        MinWidth="560"
        MinHeight="680"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="TẠO FILLED REGION THEO ROOM TRONG REVIT LINK"
                       FontSize="16"
                       FontWeight="Bold"/>
            <TextBlock Margin="0,7,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       Text="Sau khi chọn Revit Link, chọn parameter của Room cần kiểm tra. Có thể nhập mỗi từ khóa trên một dòng hoặc ngăn cách bằng dấu chấm phẩy (;). Tool tìm theo kiểu chứa từ khóa và không phân biệt chữ hoa/chữ thường."/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Parameter của Room dùng để lọc:"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbRoomFilterParameter"
                          Height="30"
                          Margin="0,6,0,0"
                          VerticalContentAlignment="Center"/>
                <TextBlock x:Name="txtRoomParameterStatus"
                           Margin="0,7,0,0"
                           Foreground="#777777"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,14,0,0"
                           Text="Giá trị parameter chứa:"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="txtKeyword"
                         Height="105"
                         MinHeight="80"
                         Margin="0,6,0,0"
                         Padding="7,5"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Ví dụ:&#x0a;Toilet&#x0a;WC&#x0a;Restroom"/>

                <TextBlock Margin="0,16,0,0"
                           Text="Filled Region Type:"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbRegionType"
                          Height="30"
                          Margin="0,6,0,0"
                          VerticalContentAlignment="Center"/>

                <TextBlock Margin="0,16,0,0"
                           Text="Vị trí lấy đường bao Room:"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbBoundary"
                          Height="30"
                          Margin="0,6,0,0"
                          VerticalContentAlignment="Center"/>

                <GroupBox Margin="0,16,0,0"
                          Padding="10"
                          Header="Chế độ xử lý Filled Region">
                    <StackPanel>
                        <RadioButton x:Name="rdoReplace"
                                     Margin="0,2,0,8"
                                     Content="Xóa vùng cũ trùng Room rồi tạo lại"
                                     IsChecked="True"/>
                        <RadioButton x:Name="rdoCreateOnly"
                                     Margin="0,0,0,8"
                                     Content="Chỉ tạo Filled Region mới, không xóa vùng cũ"/>
                        <RadioButton x:Name="rdoDeleteOnly"
                                     Content="Chỉ xóa vùng cũ trùng Room, không tạo mới"/>
                        <TextBlock Margin="22,9,0,0"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"
                                   Text="Vùng cũ được nhận diện theo dữ liệu do tool ghi lại. Với vùng tạo từ phiên bản cũ, tool đối chiếu Filled Region cùng Type có phủ bì trùng với Room."/>
                    </StackPanel>
                </GroupBox>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="165"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Lọc theo Level của Active View:"
                                   FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Text="Cho phép sai lệch cao độ giữa Level của link và Level của model hiện tại."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sai số (mm):" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtLevelTolerance"
                                 Height="30"
                                 Margin="0,6,0,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="chkCropOnly"
                          Content="Chỉ lấy Room giao với Crop Region của Active View"
                          Margin="0,18,0,8"/>
                <CheckBox x:Name="chkMatchPhase"
                          Content="Ưu tiên Phase trong link có tên trùng Phase của Active View"/>
                <CheckBox x:Name="chkFillRoomNameToComments"
                          Margin="0,8,0,0"
                          IsChecked="True"
                          Content="Tự động điền Room Name vào Comments của Filled Region"
                          ToolTip="Chỉ áp dụng cho Filled Region mới được tạo. Mã nhận diện nội bộ được lưu bằng Extensible Storage, không chiếm parameter hiển thị."/>

                <GroupBox Margin="0,16,0,0"
                          Padding="10"
                          Header="Điền tên Level của Active View vào Filled Region">
                    <StackPanel>
                        <TextBlock Text="Level sẽ được ghi:"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtActiveLevelName"
                                   Margin="0,5,0,10"
                                   Padding="8,6"
                                   Background="#F3F3F3"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="chkFillLevelToParameter"
                                  IsChecked="True"
                                  Content="Tự động điền tên Level vào instance parameter được chọn"/>

                        <TextBlock Margin="0,10,0,0"
                                   Text="Instance parameter kiểu Text:"
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="cmbLevelParameter"
                                  Height="30"
                                  Margin="0,6,0,0"
                                  VerticalContentAlignment="Center"/>

                        <TextBlock x:Name="txtLevelParameterStatus"
                                   Margin="0,8,0,0"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <Border Margin="0,16,0,0"
                        Padding="11"
                        Background="#F3F3F3"
                        CornerRadius="4">
                    <TextBlock Foreground="#555555"
                               TextWrapping="Wrap"
                               Text="Revit Link đã được chọn trước khi mở cửa sổ này để tool quét danh sách parameter của Room. Sau khi nhấn Thực hiện, tool sẽ xử lý ngay và chỉ mở một cửa sổ kết quả, kèm nút Zoom cho từng Filled Region."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="btnCancel"
                        Content="Hủy"
                        Width="95"
                        Height="34"
                        Margin="0,0,10,0"
                        IsCancel="True"/>
                <Button x:Name="btnCreate"
                        Content="Thực hiện"
                        Width="145"
                        Height="34"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
