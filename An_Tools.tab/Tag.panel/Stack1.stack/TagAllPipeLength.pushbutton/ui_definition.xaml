<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Pipes Pro"
        Height="820" Width="540"
        MinHeight="700" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#EEF2F7"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1E40AF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D8DEE9"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,18,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Tag Pipes Pro"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="1"
                           Text="Tự đặt pipe tag xếp bậc, lọc theo kích thước, hướng ống và View Range"
                           Foreground="#DBEAFE"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Thông số đặt tag" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Khoảng cách xếp bậc tính theo mm trên giấy; chiều dài và đường kính tính theo mm thực trong model."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,12" TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Khoảng cách xếp bậc" VerticalAlignment="Center" Margin="0,0,12,10"/>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtSpacing" Grid.Column="0" Text="5.0"/>
                                <TextBlock Grid.Column="1" Text="mm" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Chiều dài ống tối thiểu" VerticalAlignment="Center" Margin="0,0,12,10"/>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtMinLength" Grid.Column="0" Text="500"/>
                                <TextBlock Grid.Column="1" Text="mm" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <CheckBox x:Name="chkLimitMaxLength"
                                      Grid.Row="2" Grid.Column="0"
                                      Content="Giới hạn chiều dài ống tối đa"
                                      IsChecked="False"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,10"
                                      ToolTip="Bỏ tick để không giới hạn chiều dài ống tối đa."/>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                                  IsEnabled="{Binding IsChecked, ElementName=chkLimitMaxLength}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtMaxLength" Grid.Column="0" Text="10000"/>
                                <TextBlock Grid.Column="1" Text="mm" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Đường kính ống nhỏ nhất" VerticalAlignment="Center" Margin="0,0,12,10"/>
                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtMinSize" Grid.Column="0" Text="15"/>
                                <TextBlock Grid.Column="1" Text="mm" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <CheckBox x:Name="chkLimitMaxSize"
                                      Grid.Row="4" Grid.Column="0"
                                      Content="Giới hạn đường kính ống lớn nhất"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      ToolTip="Bỏ tick để không giới hạn đường kính ống lớn nhất."/>
                            <Grid Grid.Row="4" Grid.Column="1"
                                  IsEnabled="{Binding IsChecked, ElementName=chkLimitMaxSize}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtMaxSize" Grid.Column="0" Text="1000"/>
                                <TextBlock Grid.Column="1" Text="mm" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Phạm vi áp dụng" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                            <RadioButton x:Name="rbSelection" GroupName="ScopeGroup" Content="Dùng Pipe đã chọn trước; nếu chưa chọn thì quét sau khi bấm Đặt Tag" IsChecked="True"/>
                            <RadioButton x:Name="rbView" GroupName="ScopeGroup" Content="Toàn bộ pipe trong view hiện hành"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Lọc theo View Range" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Áp dụng cho preselection, quét chọn và toàn view. Khi chưa chọn Pipe trước, tool sẽ chặn không cho quét Pipe nằm ngoài dải đã nhập."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Vertical" Margin="0,2,0,8">
                            <RadioButton x:Name="rbViewRangeNone" GroupName="ViewRangeGroup" Content="Không lọc theo View Range" IsChecked="True"/>
                            <RadioButton x:Name="rbViewRangeActive" GroupName="ViewRangeGroup" Content="Dùng View Range hiện hành của active view"/>
                            <RadioButton x:Name="rbViewRangeManual" GroupName="ViewRangeGroup" Content="Nhập View Range thủ công"/>
                        </StackPanel>

                        <Grid Margin="18,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cao độ dưới / Bottom offset" VerticalAlignment="Center" Margin="0,0,12,10"/>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtRangeBottom" Grid.Column="0" Text="-1000"/>
                                <TextBlock Grid.Column="1" Text="mm" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cao độ trên / Top offset" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtRangeTop" Grid.Column="0" Text="3000"/>
                                <TextBlock Grid.Column="1" Text="mm" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Bộ lọc hướng ống" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <RadioButton x:Name="rbOrientationAll" GroupName="OrientationGroup" Content="Tất cả" IsChecked="True"/>
                            <RadioButton x:Name="rbOrientationHorizontal" GroupName="OrientationGroup" Content="Ống ngang / ống dốc"/>
                            <RadioButton x:Name="rbOrientationVertical" GroupName="OrientationGroup" Content="Ống đứng"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Điều kiện tag" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                            <RadioButton x:Name="rbAllPipes" GroupName="TagModeGroup" Content="Tag toàn bộ ống, xóa tag cũ nếu đã có" IsChecked="True"/>
                            <RadioButton x:Name="rbUntaggedOnly" GroupName="TagModeGroup" Content="Chỉ tag những ống chưa có tag"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Vị trí tag" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Mặc định đặt tag về bên trái ống đứng. Với ống ngang/ống dốc, tag vẫn nằm phía trên và xếp bậc sang trái."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,2,0,0">
                            <RadioButton x:Name="rbTagSideLeft" GroupName="TagSideGroup" Content="Bên trái" IsChecked="True"/>
                            <RadioButton x:Name="rbTagSideRight" GroupName="TagSideGroup" Content="Bên phải"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Loại Pipe Tag" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Lần sau mở tool sẽ tự chọn lại loại tag đã dùng gần nhất nếu family/type còn tồn tại trong project."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                        <ComboBox x:Name="cbTagTypes"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtSettingsStatus"
                           Grid.Column="0"
                           Text="Tool sẽ tự lưu cấu hình sau khi chạy lệnh."
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancel" Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="btnExecute" Content="Đặt Tag" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
