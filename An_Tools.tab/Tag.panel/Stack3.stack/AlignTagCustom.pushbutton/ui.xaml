<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Align Tag Leader"
    Width="1680"
    Height="850"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="#F3F6FB"
    FontFamily="Segoe UI"
    FontSize="13"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="SoftPrimaryBrush" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DDE7F3"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFF7ED"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LeaderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFCFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  CanContentScroll="False"
                  PanningMode="Both"
                  Focusable="False">
        <Grid Margin="18" MinWidth="1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                CornerRadius="14"
                Padding="18,14"
                Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="#0EA5E9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Align Tag Leader"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Can chinh leader tag nhanh va deu khoang cach trong active view."
                               Foreground="#DBEAFE"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        Opacity="0.95"
                        CornerRadius="10"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="Shift + Apply = chon nhieu tag"
                               Foreground="#1E3A8A"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.08*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Kieu leader" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Chon Auto de tool tu nhan dang, hoac Customize de ep theo mot kieu leader mong muon."
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{StaticResource SoftPrimaryBrush}"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <StackPanel>
                                    <RadioButton x:Name="rbAuto"
                                                 GroupName="LeaderMode"
                                                 Content="Auto"/>
                                    <TextBlock Text="Tool tu chon kieu leader theo vi tri hien tai cua tag."
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="22,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <StackPanel>
                                    <RadioButton x:Name="rbCustomize"
                                                 GroupName="LeaderMode"
                                                 Content="Customize"
                                                 IsChecked="True"/>
                                    <TextBlock Text="Chon 1 kieu leader co dinh ben duoi."
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="22,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="3" Rows="2">

                            <Border Style="{StaticResource LeaderCardStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="cb90UD"
                                              Content="90 - Up/Down"
                                              IsChecked="True"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,6"/>
                                    <Canvas Width="120" Height="76" HorizontalAlignment="Center">
                                        <Rectangle Canvas.Left="61" Canvas.Top="18" Width="43" Height="18" RadiusX="3" RadiusY="3" Fill="#E0F2FE" Stroke="#38BDF8" StrokeThickness="1"/>
                                        <Line X1="32" Y1="58" X2="32" Y2="28" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="32" Y1="28" X2="83" Y2="28" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="22" Canvas.Top="49" Width="20" Height="20" Fill="#FFFFFF" Stroke="#0F172A" StrokeThickness="2"/>
                                        <TextBlock Canvas.Left="28" Canvas.Top="50" Text="1" FontWeight="Bold" Foreground="#0F172A"/>
                                    </Canvas>
                                    <TextBlock Text="Dung khi tag nam trai/phai ong"
                                               Style="{StaticResource HintTextStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LeaderCardStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="cb90LR"
                                              Content="90 - Left/Right"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,6"/>
                                    <Canvas Width="120" Height="76" HorizontalAlignment="Center">
                                        <Rectangle Canvas.Left="65" Canvas.Top="6" Width="38" Height="18" RadiusX="3" RadiusY="3" Fill="#E0F2FE" Stroke="#38BDF8" StrokeThickness="1"/>
                                        <Line X1="22" Y1="44" X2="72" Y2="44" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="72" Y1="44" X2="72" Y2="16" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="12" Canvas.Top="35" Width="20" Height="20" Fill="#FFFFFF" Stroke="#0F172A" StrokeThickness="2"/>
                                        <TextBlock Canvas.Left="18" Canvas.Top="36" Text="1" FontWeight="Bold" Foreground="#0F172A"/>
                                    </Canvas>
                                    <TextBlock Text="Dung khi tag nam tren/duoi ong"
                                               Style="{StaticResource HintTextStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LeaderCardStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="cb45UD"
                                              Content="45 - Up/Down"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,6"/>
                                    <Canvas Width="120" Height="76" HorizontalAlignment="Center">
                                        <Rectangle Canvas.Left="67" Canvas.Top="18" Width="38" Height="18" RadiusX="3" RadiusY="3" Fill="#E0F2FE" Stroke="#38BDF8" StrokeThickness="1"/>
                                        <Line X1="28" Y1="58" X2="56" Y2="30" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="56" Y1="30" X2="86" Y2="30" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="18" Canvas.Top="49" Width="20" Height="20" Fill="#FFFFFF" Stroke="#0F172A" StrokeThickness="2"/>
                                        <TextBlock Canvas.Left="24" Canvas.Top="50" Text="1" FontWeight="Bold" Foreground="#0F172A"/>
                                    </Canvas>
                                    <TextBlock Text="Cheo 45 do (hoac goc nhap tay) roi ngang"
                                               Style="{StaticResource HintTextStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LeaderCardStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="cb45LR"
                                              Content="45 - Left/Right"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,6"/>
                                    <Canvas Width="120" Height="76" HorizontalAlignment="Center">
                                        <Rectangle Canvas.Left="78" Canvas.Top="5" Width="36" Height="18" RadiusX="3" RadiusY="3" Fill="#E0F2FE" Stroke="#38BDF8" StrokeThickness="1"/>
                                        <Line X1="22" Y1="45" X2="58" Y2="45" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="58" Y1="45" X2="88" Y2="15" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="12" Canvas.Top="36" Width="20" Height="20" Fill="#FFFFFF" Stroke="#0F172A" StrokeThickness="2"/>
                                        <TextBlock Canvas.Left="18" Canvas.Top="37" Text="1" FontWeight="Bold" Foreground="#0F172A"/>
                                    </Canvas>
                                    <TextBlock Text="Ngang roi cheo 45 do (hoac goc nhap tay)"
                                               Style="{StaticResource HintTextStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LeaderCardStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="cbStraightUD"
                                              Content="Straight - Up/Down"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,6"/>
                                    <Canvas Width="120" Height="76" HorizontalAlignment="Center">
                                        <Rectangle Canvas.Left="48" Canvas.Top="6" Width="38" Height="18" RadiusX="3" RadiusY="3" Fill="#E0F2FE" Stroke="#38BDF8" StrokeThickness="1"/>
                                        <Line X1="60" Y1="62" X2="60" Y2="16" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="50" Canvas.Top="53" Width="20" Height="20" Fill="#FFFFFF" Stroke="#0F172A" StrokeThickness="2"/>
                                        <TextBlock Canvas.Left="56" Canvas.Top="54" Text="1" FontWeight="Bold" Foreground="#0F172A"/>
                                    </Canvas>
                                    <TextBlock Text="Leader thang theo Y"
                                               Style="{StaticResource HintTextStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LeaderCardStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="cbStraightLR"
                                              Content="Straight - Left/Right"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,6"/>
                                    <Canvas Width="120" Height="76" HorizontalAlignment="Center">
                                        <Rectangle Canvas.Left="72" Canvas.Top="34" Width="38" Height="18" RadiusX="3" RadiusY="3" Fill="#E0F2FE" Stroke="#38BDF8" StrokeThickness="1"/>
                                        <Line X1="20" Y1="44" X2="92" Y2="44" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="10" Canvas.Top="35" Width="20" Height="20" Fill="#FFFFFF" Stroke="#0F172A" StrokeThickness="2"/>
                                        <TextBlock Canvas.Left="16" Canvas.Top="36" Text="1" FontWeight="Bold" Foreground="#0F172A"/>
                                    </Canvas>
                                    <TextBlock Text="Leader thang theo X"
                                               Style="{StaticResource HintTextStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Kich thuoc" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Nhap gia tri theo mm. Tool tu luu lai cau hinh sau moi lan Apply."
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,4,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="118"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox x:Name="cbUseShoulderLength"
                                          Content="Shoulder length"
                                          IsChecked="True"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="Chieu dai tu elbow den text."
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="22,2,8,0"/>
                            </StackPanel>
                            <TextBox x:Name="tbShoulder"
                                     Grid.Column="1"
                                     Text="20 mm"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="118"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox x:Name="cbUseElbowLength"
                                          Content="Elbow length (Arrow)"
                                          IsChecked="True"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="Chieu dai tu mui ten den elbow."
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="22,2,8,0"/>
                            </StackPanel>
                            <TextBox x:Name="tbElbow"
                                     Grid.Column="1"
                                     Text="20 mm"/>
                        </Grid>

                        <TextBlock Text="Luu y: khi chi tick 1 trong 2 length, tool uu tien giu nguyen length bo tick; Tag spacing se khong ap dung cho batch nhieu tag."
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="118"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tag spacing" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Khoang cach giua cac dong tag" Style="{StaticResource HintTextStyle}"/>
                            </StackPanel>
                            <TextBox x:Name="tbTagSpacing"
                                     Grid.Column="1"
                                     Text="50 mm"/>
                        </Grid>

                        <Border Background="#F8FAFC"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="118"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <CheckBox x:Name="cbCustomAngle"
                                              Content="Nhap goc cho nhom 45"
                                              FontWeight="SemiBold"/>
                                    <TextBlock Text="Bo tick: chay dung logic 45 do nguyen thuy. Goc tinh so voi phuong ngang, yeu cau 0 &lt; goc &lt; 90."
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="22,3,8,0"/>
                                </StackPanel>

                                <TextBox x:Name="tbCustomAngle"
                                         Grid.Column="1"
                                         Text="45 deg"
                                         IsEnabled="False"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Dan cach tag" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Chon huong sap xep khi xu ly nhieu tag."
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,4,0,14"/>

                        <Border Background="#F8FAFC"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="cbDistributeX"
                                          Content="Horizontal X"
                                          IsChecked="True"
                                          FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="Day tag trai/phai, khoa toa do Y"
                                           Style="{StaticResource HintTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Background="#F8FAFC"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="cbDistributeY"
                                          Content="Vertical Y"
                                          FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="Day tag len/xuong, khoa toa do X"
                                           Style="{StaticResource HintTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource DangerSoftBrush}"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Cach dung"
                                           FontWeight="SemiBold"
                                           Foreground="#9A3412"/>
                                <TextBlock Text="1. Chon cau hinh va bam Apply."
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="2. Click tag can can chinh. Nhan Esc de ket thuc."
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="3. Giu Shift khi bam Apply de chon nhieu tag trong mot lan."
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button x:Name="btnCancel"
                            Content="Cancel"
                            Width="96"
                            Margin="0,0,10,0"/>

                    <Button x:Name="btnApply"
                            Content="Apply"
                            Width="112"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryDarkBrush}"
                            Foreground="White"/>
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </ScrollViewer>
</Window>
